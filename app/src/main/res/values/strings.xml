    <string name="delete_category_message_no_entries">This category has no entries. Deleting it cannot be undone.</string>
    <!-- Each of these two plurals has one permanently unreachable quantity: the entry table's
         UNIQUE (category_id, date) index forces a category's entries onto distinct dates, so
         earliestDate == latestDate exactly when there is a single entry. In English-rule
         locales the no-date message can therefore only ever appear with quantity "one", and
         the range message only ever with "other". Locales without singular/plural
         distinctions (e.g. Japanese) select "other" even for a single entry, so the no-date
         "other" item is live there too - only range "one" is dead in every locale. Keep the
         dead quantities anyway: plural resources are expected to provide them, and they keep
         the messages truthful should the constraint ever change. -->
    <plurals name="delete_category_message_with_entries_range">
        <item quantity="one">This will permanently delete one entry from %2$s to %3$s. This action cannot be undone.</item>
        <item quantity="other">This will permanently delete %1$d entries from %2$s to %3$s. This action cannot be undone.</item>
    </plurals>
    <plurals name="delete_category_message_with_entries_no_date">
        <item quantity="one">This will permanently delete one entry. This action cannot be undone.</item>
        <item quantity="other">This will permanently delete %1$d entries. This action cannot be undone.</item>
    </plurals>
